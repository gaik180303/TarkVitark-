# Server
PORT=8000
NODE_ENV=development

# MongoDB connection string WITHOUT a trailing database name
# (the app appends /debate_db itself — see src/constant.js)
MONGODB_URI=mongodb://127.0.0.1:27017

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# JWT secrets — generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary (profile picture uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI layer — optional. Without a key it runs in deterministic "demo mode".
# Set LLM_PROVIDER=groq and a key to enable real fact-checking / summaries / AI judge.
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Or use Gemini instead:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=

# Razorpay (payment module — optional, unfinished)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
